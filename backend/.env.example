# ============ 数据库（改这一行即可切换；切完执行 alembic upgrade head）============
# SQLite（默认，零配置）
DATABASE_URL=sqlite:///./workspace/db.sqlite3
# PostgreSQL：pip install -e ".[postgres]"
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/kb?sslmode=disable
# MySQL：pip install -e ".[mysql]"
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/kb?charset=utf8mb4
# Oracle：pip install -e ".[oracle]"
# DATABASE_URL=oracle+oracledb://user:password@localhost:1521/?service_name=ORCL
# SQL Server：pip install -e ".[mssql]"
# DATABASE_URL=mssql+pymssql://user:password@localhost:1433/kb

DB_ECHO=false

# ============ 认证（部署到生产务必修改 JWT_SECRET 与管理员密码）============
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ALLOW_REGISTRATION=false

# ============ Git 凭据加密（务必设置，否则回退用 JWT_SECRET）============
# 用于加密仓库的 Token / 密码 / SSH 私钥；生产环境请填一个长随机串
CREDENTIAL_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ============ LLM（可选，留空走本地规则模式）============
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_ENABLED=true
LLM_MAX_DIFF_CHARS=12000
COMMIT_WEB_BASE_URL=

# ============ 分析 ============
HISTORY_LIMIT=60
MAX_FILES=300
WORKSPACE_DIR=./workspace

# ============ 应用 ============
APP_NAME=代码变更历史知识库
VERSION=2.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
